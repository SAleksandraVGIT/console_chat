@startuml console_chat_client
allowmixing
title console_chat - client

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam wrapWidth 220

actor "Console user" as User

package "Client application (console_chat)" {
  class ClientMain <<entry point>> {
    +main(argc, argv) : int
  }

  class ChatConsole {
    +ChatConsole(service)
    +Run() : int
    +RunAdmin() : int
    -UserMenu()
    -AdminMenu()
    -RegistrationFlow()
    -LoginFlow()
    -AdminLoginFlow()
    -CreatePrivateChatFlow()
    -DeleteAccountFlow()
    -OpenChatFlow()
    -OpenGeneralChatFlow()
    -ChatSession(chatName)
    -ShowMyChatsFlow()
    -ShowAllUsersFlow()
    -AdminShowUsersFlow()
    -AdminShowChatsFlow()
    -AdminCreatePrivateChatFlow()
    -AdminOpenPrivateChatFlow()
    -AdminOpenGeneralChatFlow()
    -AdminChatSession(chatName, canSend)
    -AdminKickUserFlow()
    -AdminBanUserFlow()
    -AdminUnbanUserFlow()
    -AdminDeleteForeverBannedUsersFlow()
    -ShowMainMenu()
    -ShowUserMenu()
    -ShowAdminMainMenu()
    -ShowAdminMenu()
    -m_service : ChatClient&
  }

  class ChatClient {
    +ChatClient(host, port)
    +~ChatClient()
    +Register(name, login, password) : bool
    +Authenticate(login, password) : bool
    +AuthenticateDetailed(login, password) : AuthResult
    +Logout()
    +DeleteAccount(confirmationLogin) : bool
    +IsAuthenticated() : bool
    +GetCurrentUserLogin() : string
    +GetCurrentUserName() : string
    +GetMyChats() : vector<string>
    +CreatePrivateChat(recipientLogin, chatName) : bool
    +CreatePrivateChatDetailed(recipientLogin, chatName) : CreatePrivateChatResult
    +GetMessages(chatName) : vector<Message>
    +SendMessage(chatName, text) : bool
    +GetAllUserLogins() : vector<string>
    +AdminLogin(login, password) : bool
    +AdminGetUsers() : vector<AdminUserInfo>
    +AdminGetChats() : vector<AdminChatInfo>
    +AdminCreatePrivateChat(recipientLogin, chatName) : bool
    +AdminCreatePrivateChatDetailed(recipientLogin, chatName) : CreatePrivateChatResult
    +AdminGetMessages(chatName) : vector<Message>
    +AdminSendMessageToChat(chatName, text) : bool
    +AdminSendGeneral(text) : bool
    +AdminKickUser(login) : bool
    +AdminBanUser(login, period) : bool
    +AdminUnbanUser(login) : bool
    +AdminDeleteForeverBannedUsers() : int
    -Request(parts) : vector<string>
    -{static} Split(line, delim) : vector<string>
    -m_socket : TcpSocket
  }

  enum ActionMainMenu {
    EXIT = 0
    REGISTRATION = 1
    LOGIN = 2
  }

  enum ActionUserMenu {
    LOG_OUT = 0
    SHOW_MY_CHATS = 1
    CREATE_PRIVATE_CHAT = 2
    OPEN_PRIVATE_CHAT = 3
    OPEN_GENERAL_CHAT = 4
    SHOW_ALL_USERS = 5
    DELETE_ACCOUNT = 6
  }

  enum ActionAdminMainMenu {
    EXIT = 0
    LOGIN = 1
  }

  enum ActionAdminMenu {
    LOG_OUT = 0
    SHOW_USERS = 1
    SHOW_CHATS = 2
    CREATE_PRIVATE_CHAT = 3
    OPEN_PRIVATE_CHAT = 4
    OPEN_GENERAL_CHAT = 5
    KICK_USER = 6
    BAN_USER = 7
    UNBAN_USER = 8
    DELETE_FOREVER_BANNED_USERS = 9
  }
}

package "Network" {
  class TcpSocket {
    +TcpSocket()
    +TcpSocket(fd)
    +~TcpSocket()
    +TcpSocket(other&&)
    +operator=(other&&) : TcpSocket&
    +Connect(host, port)
    +SendLine(line) : bool
    +RecvLine(line) : bool
    +SetReceiveTimeout(timeout) : bool
    +WasLastReceiveTimedOut() : bool
    +Close()
    +IsValid() : bool
    -EnsureCreated()
    -m_fd : intptr_t
  }
}

package "Shared model" {
  class Message <<struct>> {
    +Name : string
    +Text : string
  }

  class AuthResult <<struct>> {
    +Success : bool
    +Error : string
    +BanStatus : string
    +BannedUntilEpoch : string
    +ServerNowEpoch : string
  }

  class CreatePrivateChatResult <<struct>> {
    +Success : bool
    +ExistingChatName : string
  }

  class AdminUserInfo <<struct>> {
    +Login : string
    +Name : string
    +BanStatus : string
    +BannedUntilEpoch : string
    +ServerNowEpoch : string
  }

  class AdminChatInfo <<struct>> {
    +Name : string
    +Type : string
    +FirstUserLogin : string
    +SecondUserLogin : string
  }
}

User --> ChatConsole : menu and chat input
ClientMain ..> ChatClient : creates with host and port
ClientMain ..> ChatConsole : creates and runs
ChatConsole o-- ChatClient : uses
ChatConsole ..> ActionMainMenu
ChatConsole ..> ActionUserMenu
ChatConsole ..> ActionAdminMainMenu
ChatConsole ..> ActionAdminMenu
ChatClient *-- TcpSocket : owns connection
ChatClient ..> Message : creates from response
ChatClient ..> AuthResult : detailed login response
ChatClient ..> CreatePrivateChatResult
ChatClient ..> AdminUserInfo
ChatClient ..> AdminChatInfo
TcpSocket --> "chat_server" : TCP line protocol

note right of ChatClient
  Request format:
  COMMAND<TAB>ARG1<TAB>ARG2\n

  Response format:
  OK<TAB>DATA...
  ERR<TAB>DESCRIPTION

  Banned login:
  ERR<TAB>banned<TAB>TEMP|FOREVER<TAB>until<TAB>serverNow

  Forced disconnect:
  ERR<TAB>disconnected by ADMIN
  ERR<TAB>disconnected by inactivity timeout
end note

note bottom of TcpSocket
  The client keeps one TCP connection
  for the lifetime of ChatClient.
  --admin only selects a different menu.
end note

@enduml

@startuml console_chat_client_request
title console_chat - client request flow

skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam wrapWidth 220

actor "Console user" as User
participant "ChatConsole" as Console
participant "ChatClient" as Client
participant "TcpSocket" as Socket
participant "chat_server" as Server

User -> Console : select action and enter data
Console -> Client : call public API method
Client -> Client : build command parts
Client -> Client : Join(parts, TAB)
Client -> Socket : SendLine(payload)
Socket -> Server : TCP request line
Server --> Socket : TCP response line
Client -> Socket : RecvLine(response)
Client -> Client : Split(response, TAB)

alt response starts with OK
  Client --> Console : result or response data
  Console --> User : show updated view
else response starts with ERR
  Client --> Console : false or empty result
  Console --> User : show operation failure
end

@enduml
